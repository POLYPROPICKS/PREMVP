{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -d \"${CLAUDE_PROJECT_DIR}/node_modules\" ] || (cd \"${CLAUDE_PROJECT_DIR}\" && npm ci)'",
            "timeout": 600,
            "statusMessage": "Ensuring dependencies are installed..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-proof-package.mjs\" \"${transcript_path}\"",
            "timeout": 30,
            "statusMessage": "Checking proof package completeness..."
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/evolution-governor-stop-gate.mjs\" \"${transcript_path}\"",
            "timeout": 30,
            "statusMessage": "Enforcing Evolution/Governor terminal persistence..."
          }
        ]
      }
    ]
  }
}
