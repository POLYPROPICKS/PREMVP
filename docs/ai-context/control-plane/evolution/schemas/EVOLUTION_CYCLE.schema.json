{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://polypropicks.com/schemas/control-plane/evolution/EVOLUTION_CYCLE.schema.json",
  "title": "PolyProPicks Evolution Cycle",
  "description": "The machine-readable result of one Daily Evolution Review. Enforced by scripts/control-plane/lib/evolution-cycle.mjs — a focused dependency-free validator, not a generic JSON Schema engine. All detailed machine evidence lives here; the Founder report is the plain-language view of the same cycle.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "cycle_id",
    "period_start",
    "period_end",
    "repository",
    "generated_by",
    "inputs",
    "axis_a",
    "axis_b",
    "supporting_metrics",
    "operator_actions",
    "automation_hypotheses",
    "founder_practices",
    "experiments",
    "roadmap",
    "next_step",
    "accepted"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "cycle_id": { "type": "string", "minLength": 1 },
    "period_start": { "type": "string", "minLength": 1 },
    "period_end": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "const": "POLYPROPICKS/PREMVP" },
    "generated_by": {
      "type": "object",
      "required": ["executor", "model_label", "prompt_id"],
      "properties": {
        "executor": { "type": "string", "enum": ["claude_code_cloud", "local_codex_windows"] },
        "model_label": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["completion_envelope_ids", "confirmed_changes", "input_bundle_ref"],
      "properties": {
        "completion_envelope_ids": { "type": "array", "items": { "type": "string" } },
        "confirmed_changes": { "type": "array", "items": { "type": "string" } },
        "input_bundle_ref": { "type": "string", "minLength": 1 }
      }
    },

    "axis_a": {
      "type": "object",
      "description": "Launch, revenue, settlement and reconciled PnL. Derived only from evidence, never from supporting metrics.",
      "required": [
        "verdict",
        "what_moved",
        "next_verified_production_fact_now_possible",
        "blockers_removed",
        "blockers_introduced",
        "not_proven",
        "runtime_or_business_evidence_exists",
        "pnl"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["ADVANCED", "NO_MEASURABLE_CHANGE", "STALLED", "REGRESSED", "NOT_ENOUGH_EVIDENCE"]
        },
        "what_moved": { "type": "array", "items": { "$ref": "#/definitions/claim" } },
        "next_verified_production_fact_now_possible": { "type": ["string", "null"] },
        "blockers_removed": { "type": "array", "items": { "$ref": "#/definitions/claim" } },
        "blockers_introduced": { "type": "array", "items": { "$ref": "#/definitions/claim" } },
        "not_proven": { "type": "array", "items": { "type": "string" } },
        "runtime_or_business_evidence_exists": { "type": "boolean" },
        "pnl": {
          "type": "object",
          "required": ["reconciled_claimed", "evidence_kinds"],
          "properties": {
            "reconciled_claimed": { "type": "boolean" },
            "evidence_kinds": {
              "type": "array",
              "items": { "type": "string", "enum": ["FILLS", "FEES", "SETTLEMENT"] }
            },
            "evidence_refs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },

    "axis_b": {
      "type": "object",
      "description": "Reusable Manifest 2 capability. Never derived from Axis A and never averaged with it.",
      "required": ["verdict", "capabilities", "not_proven"],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["CAPABILITY_ADDED", "CAPABILITY_STRENGTHENED", "PRACTICED_NOT_YET_PROVEN", "NO_MEASURABLE_CHANGE", "REGRESSED"]
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["domain", "statement", "persisted_artifact", "use_or_validation_evidence", "evidence_refs"],
            "properties": {
              "domain": {
                "type": "string",
                "enum": [
                  "MISSION_CONTRACTS",
                  "VERIFICATION_AND_EVIDENCE",
                  "MISSION_REGISTRY",
                  "DECLARATIVE_ENVIRONMENTS",
                  "PERMISSION_AND_TOOL_POLICY",
                  "REUSABLE_FUNCTIONS_SCRIPTS_VALIDATORS",
                  "PORTABILITY_ACROSS_CLOUDCODE_AND_CODEX",
                  "RECOVERY_AND_CHECKPOINTS",
                  "AUTOMATION_ECONOMICS",
                  "CONTROLLED_IMPROVEMENT"
                ]
              },
              "statement": { "type": "string", "minLength": 1 },
              "persisted_artifact": { "type": "string", "minLength": 1, "description": "Tracked repository path. An LLM description is not a capability." },
              "use_or_validation_evidence": { "type": "string", "minLength": 1 },
              "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "not_proven": { "type": "array", "items": { "type": "string" } }
      }
    },

    "supporting_metrics": {
      "type": "object",
      "required": ["role", "values"],
      "properties": {
        "role": { "type": "string", "const": "DIAGNOSTIC_ONLY" },
        "values": {
          "type": "object",
          "description": "Every key resolves to a number or the literal string UNKNOWN or NOT_AVAILABLE.",
          "additionalProperties": {
            "anyOf": [{ "type": "number" }, { "type": "string", "enum": ["UNKNOWN", "NOT_AVAILABLE"] }]
          }
        }
      }
    },

    "operator_actions": { "$ref": "OPERATOR_ACTION_SUMMARY.schema.json" },

    "automation_hypotheses": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "AUTOMATION_HYPOTHESIS.schema.json" }
    },
    "insufficient_supported_hypotheses": {
      "type": "boolean",
      "description": "Required true, with a reason, when fewer than five hypotheses are supported by evidence."
    },
    "insufficient_supported_hypotheses_reason": { "type": ["string", "null"] },

    "founder_practices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "skill_practiced", "why_it_matters_now", "how_it_applies_to_current_project", "persistent_git_artifact"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "skill_practiced": { "type": "string", "minLength": 1 },
          "why_it_matters_now": { "type": "string", "minLength": 1 },
          "how_it_applies_to_current_project": { "type": "string", "minLength": 1 },
          "persistent_git_artifact": { "type": "string", "minLength": 1 },
          "ladder_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 7 }
        }
      }
    },
    "founder_practice_comparison": { "type": "string", "minLength": 1 },
    "founder_practice_recommended_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },

    "experiments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "hypothesis", "bounded_scope", "persistent_artifact", "promotion_condition", "stop_condition"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "hypothesis": { "type": "string", "minLength": 1 },
          "bounded_scope": { "type": "string", "minLength": 1 },
          "persistent_artifact": { "type": "string", "minLength": 1 },
          "promotion_condition": { "type": "string", "minLength": 1 },
          "stop_condition": { "type": "string", "minLength": 1 }
        }
      }
    },

    "roadmap": {
      "type": "object",
      "required": ["evolution_stage", "product_phase_unchanged"],
      "properties": {
        "evolution_stage": {
          "type": "string",
          "enum": ["STAGE_1_DAILY_EVOLUTION_ROUTINE_MVP", "STAGE_2_AUTOMATION_ROADMAP_AND_GOVERNANCE", "VISION_AGENT_OPERATING_SYSTEM"]
        },
        "product_phase_unchanged": { "type": "boolean", "const": true },
        "observed_product_phase": { "type": ["string", "null"] }
      }
    },

    "next_step": { "type": "string", "minLength": 1 },

    "corrections": { "type": "array", "items": { "$ref": "FOUNDER_CORRECTION.schema.json" } },

    "accepted": {
      "type": "boolean",
      "const": false,
      "description": "A cycle is evidence and proposal only. The writing executor never accepts it."
    }
  },

  "definitions": {
    "claim": {
      "type": "object",
      "required": ["statement", "evidence_class", "evidence_refs"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "evidence_class": {
          "type": "string",
          "enum": ["PROVEN_IN_RUNTIME", "FOUNDER_ACCEPTED_EXTERNAL_AUDIT", "FOUNDER_ACCEPTED_EXTERNAL_CHECKPOINT", "SUPPORTED", "NOT_PROVEN"]
        },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  },

  "x-invariants": [
    "axis_a and axis_b carry independent verdicts and are never merged or averaged.",
    "supporting_metrics.role must be DIAGNOSTIC_ONLY and may not contain any axis verdict key.",
    "Every material claim carries at least one evidence reference.",
    "axis_a.pnl.reconciled_claimed true requires FILLS, FEES and SETTLEMENT evidence kinds and at least one evidence reference; otherwise the cycle is rejected as UNSUPPORTED_PNL_CLAIM.",
    "founder_practices contains exactly two entries.",
    "experiments contains two or three entries, each with a persistent artifact, a promotion condition and a stop condition.",
    "Fewer than five automation hypotheses requires insufficient_supported_hypotheses true with a reason.",
    "roadmap.product_phase_unchanged must be true — an Evolution cycle never changes the product phase.",
    "accepted must be false."
  ]
}
